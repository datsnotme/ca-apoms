APP_NAME="CA-APOMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB. Local development uses XAMPP's bundled MariaDB by default
# (root user, no password) — change DB_USERNAME/DB_PASSWORD for a real
# MySQL server in staging/production. Never commit real credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ca_apoms
DB_USERNAME=root
DB_PASSWORD=

# Phase 8C (Backup and Restore) shells out to the MySQL client binaries.
# Uncomment and set these only if `mysqldump`/`mysql` are not already on
# PATH — e.g. a XAMPP install, where they typically live under
# C:/xampp/mysql/bin/mysqldump.exe and C:/xampp/mysql/bin/mysql.exe. Use
# forward slashes even on Windows — dotenv rejects backslash escapes.
# DB_MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
# DB_MYSQL_PATH=C:/xampp/mysql/bin/mysql.exe

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is not yet wired to any notification (Phase 6+); "log" driver writes
# would-be emails to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ca-apoms.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
